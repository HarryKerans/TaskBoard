# Optional: pre-fill the login form (do not commit .env)
REACT_APP_AMAZON_EMAIL=your@email.com
REACT_APP_AMAZON_PASSWORD=yourpassword
REACT_APP_AMAZON_COUNTRY=com

# Database path (defaults to backend/data/tasks.db for local dev; /data/tasks.db in Docker/HA)
# DATABASE_PATH=/data/tasks.db

# Backend URL (defaults to http://localhost:8000)
REACT_APP_API_URL=http://localhost:8000
